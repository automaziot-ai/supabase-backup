{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "install/Dockerfile" },
  "deploy": {
    "startCommand": "/usr/local/bin/supercronic -passthrough-logs /etc/crontab.backup",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
