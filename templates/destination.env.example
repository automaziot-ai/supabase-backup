# Single destination for ALL clients. Place at /opt/backup-supabase/destination.env on the runner.

DEST_KIND=railway     # railway | s3
DEST_BUCKET=supabase-backups
DEST_S3_REGION=us-east-1

# Railway Object Storage (created via `railway add` in the %storage project; private by default)
DEST_S3_ENDPOINT=https://bucket-production-xxxx.up.railway.app
DEST_S3_ACCESS_KEY_ID=
DEST_S3_SECRET_ACCESS_KEY=

# AWS S3 alternative (leave DEST_S3_ENDPOINT empty for AWS):
# DEST_KIND=s3
# DEST_S3_ENDPOINT=
# DEST_S3_REGION=eu-central-1
# DEST_S3_ACCESS_KEY_ID=AKIA...
# DEST_S3_SECRET_ACCESS_KEY=...
# DEST_BUCKET=automaziot-supabase-backups

# Failure notification — n8n webhook (deploy n8n/backup-failure-alert.workflow.json first)
WEBHOOK_URL=https://eyaly555.app.n8n.cloud/webhook/supabase-backup-failed

# Retention (days). Defaults match the spec.
DAILY_RETENTION_DAYS=10
WEEKLY_RETENTION_DAYS=28
