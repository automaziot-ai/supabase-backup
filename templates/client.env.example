# Per-client config. Copy to clients/<slug>.env on the runner. Mode 600.
# Filename slug (no spaces) is what appears in S3 paths and webhook alerts.

CLIENT_NAME=acme

# --- Supabase project ---
SUPABASE_PROJECT_REF=abcdefghijklmnop
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pooler URL — Settings → Database → Connection string → "Transaction" pooler. Must include password.
SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmnop:DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Source storage (read FROM Supabase) ---
# Generate in dashboard: Storage → S3 Connection → New access key
SRC_S3_ENDPOINT=https://abcdefghijklmnop.supabase.co/storage/v1/s3
SRC_S3_REGION=eu-central-1
SRC_S3_ACCESS_KEY_ID=
SRC_S3_SECRET_ACCESS_KEY=

# --- Edge functions ---
# AUTO = discover via Management API. Or comma-separated list: fn-one,fn-two
EDGE_FUNCTIONS=AUTO

# --- Encryption (recommended) ---
# GPG recipient (key id, email, or fingerprint). Public key must be imported on the runner.
# Leave empty to disable encryption for this client.
GPG_RECIPIENT=

# --- Egress reducers (all OPTIONAL; leave unset for the historical full backup) ---
# See README § "Cutting Supabase egress". Supabase free plan = 5 GB egress/month.
# Storage: keep a persistent mirror at the destination; only new/changed objects
# (compared by size) are downloaded. Not compatible with GPG_RECIPIENT (falls back to full).
#STORAGE_MODE=incremental
# Days to keep superseded object versions (storage-mirror/history/). Default: WEEKLY_RETENTION_DAYS.
#STORAGE_HISTORY_RETENTION_DAYS=28
# DB: skip ROWS (schema is still dumped) of re-creatable tables. Comma-separated
# pg_dump --exclude-table-data patterns; quote mixed-case names: public."MyTable"
# (in this file, wrap such a value in single quotes; on Railway paste it as-is).
#PG_DUMP_EXCLUDE_TABLE_DATA=products.*,public.*_raw,public.*_tmp
# ISO weekday (Asia/Jerusalem, 1=Mon … 7=Sun) on which the exclusions are ignored.
# 7 = the Sunday run, which is also the one promoted to weekly/.
#FULL_DUMP_WEEKDAY=7
# Render db.sql.gz from db.dump locally instead of a second pg_dump (halves DB egress).
#PG_DUMP_SINGLE_PASS=1
# Abort before reading anything from Supabase if the destination bucket rejects a write.
#DEST_PREFLIGHT=1
