# Per-client config. Copy to clients/<slug>.env on the runner. Mode 600.
# Filename slug (no spaces) is what appears in S3 paths and webhook alerts.

CLIENT_NAME=acme

# --- Supabase project ---
SUPABASE_PROJECT_REF=abcdefghijklmnop
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pooler URL — Settings → Database → Connection string → "Transaction" pooler. Must include password.
SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmnop:DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Source storage (read FROM Supabase) ---
# Generate in dashboard: Storage → S3 Connection → New access key
SRC_S3_ENDPOINT=https://abcdefghijklmnop.supabase.co/storage/v1/s3
SRC_S3_REGION=eu-central-1
SRC_S3_ACCESS_KEY_ID=
SRC_S3_SECRET_ACCESS_KEY=

# --- Edge functions ---
# AUTO = discover via Management API. Or comma-separated list: fn-one,fn-two
EDGE_FUNCTIONS=AUTO

# --- Encryption (recommended) ---
# GPG recipient (key id, email, or fingerprint). Public key must be imported on the runner.
# Leave empty to disable encryption for this client.
GPG_RECIPIENT=
